{
  "name": "blog-demo",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "fetch:stocks": "node scripts/fetch-stocks.mjs",
    "fetch:market": "node scripts/fetch-market.mjs",
    "fetch:all": "npm run fetch:market && npm run fetch:stocks",
    "check": "astro check",
    "build": "astro build && node scripts/index-search.mjs",
    "preview": "astro preview",
    "studio": "node --watch studio/server.mjs",
    "changelog": "node scripts/changelog.mjs",
    "test:smoke": "node tests/run.mjs",
    "test:unit": "node --test tests/lib.test.mjs tests/studio.test.mjs tests/market.test.mjs tests/covers.test.mjs",
    "test": "npm run test:unit && npm run test:smoke",
    "refresh:sectors": "node scripts/refresh-sectors.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "exifr": "^7.1.3",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "typescript": "^5.7.0"
  }
}
