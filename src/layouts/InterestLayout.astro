---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';

interface Props {
  icon: IconName;
  title: string;
  description?: string;
}
const { icon, title, description } = Astro.props;
const B = import.meta.env.BASE_URL;
---
<BaseLayout title={title} description={description ?? `${title}的小 demo`}>
  <p class="back-link"><a href={`${B}interests/`}>← 返回兴趣列表</a></p>
  <div class="demo-head">
    <div class="demo-head-icon" transition:name={`interest-${title}`}>
      <Icon name={icon} size={40} />
    </div>
    <div>
      <h1>{title}</h1>
      {description && <p class="demo-head-desc">{description}</p>}
    </div>
  </div>
  <slot />
</BaseLayout>
