---
// 调色台：原本是摄影页的整页 demo。摄影与旅行合并进 /moments/ 后，
// 它降为时间线底部的折叠彩蛋 —— 和照片主题相关，但不该挡在内容前面。
// 容器类用 .photo-lab 而不是 .demo-card：同页若再有别的 demo，
// markReady 按 .demo-card 找会撞上。
const sliders = [
  { id: 'brightness', label: '亮度', min: 50, max: 150, value: 100, unit: '%' },
  { id: 'contrast', label: '对比度', min: 50, max: 150, value: 100, unit: '%' },
  { id: 'saturate', label: '饱和度', min: 0, max: 200, value: 100, unit: '%' },
  { id: 'hue', label: '色相', min: 0, max: 360, value: 0, unit: '°' },
];
const presets = [
  { key: 'none', label: '原片' },
  { key: 'film', label: '胶片' },
  { key: 'bw', label: '黑白' },
  { key: 'vivid', label: '鲜艳' },
];
---
  <div class="demo-card photo-lab">
    <div class="photo-frame">
      <svg id="photo" viewBox="0 0 400 260" role="img" aria-label="示例风景照：远山、太阳和草地">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8ec5fc" />
            <stop offset="100%" stop-color="#f6d5b8" />
          </linearGradient>
        </defs>
        <rect width="400" height="260" fill="url(#sky)" />
        <circle cx="316" cy="78" r="38" fill="#ffd166" />
        <polygon points="0,205 115,88 230,205" fill="#7b93b8" />
        <polygon points="120,205 245,62 400,205" fill="#5b7398" />
        <polygon points="248,205 338,118 400,205" fill="#435a7d" />
        <polygon points="150,112 168,132 132,132" fill="#eef3ff" opacity="0.9" />
        <rect y="205" width="400" height="55" fill="#8fbf7f" />
        <rect y="205" width="400" height="8" fill="#7aa96c" />
      </svg>
    </div>

    <div class="demo-row" role="group" aria-label="预设风格">
      {presets.map((p, i) => (
        <button class="chip" type="button" data-preset={p.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

    {sliders.map((s) => (
      <>
        <div class="slider-head">
          <label class="demo-label" for={s.id}>{s.label}</label>
          <span class="slider-val" aria-hidden="true"><span id={`v-${s.id}`}>{s.value}</span>{s.unit}</span>
        </div>
        <input type="range" id={s.id} min={s.min} max={s.max} value={s.value} />
      </>
    ))}

    <div class="demo-row">
      <button id="reset" class="demo-btn ghost" type="button">重置</button>
      <code id="css-out" class="css-code"></code>
    </div>
  </div>

  <style>
  /* 原生 range 默认净高 22px，差 2px 到 WCAG 2.2 的 24。
     加高度不改轨道粗细，只是把可拖区域撑够 */
  input[type='range'] { height: 26px; }

    .photo-frame {
      border-radius: 12px; overflow: hidden; border: 1px solid var(--border);
      background: #0f172a;
    }
    .photo-frame svg {
      display: block; width: 100%; height: auto;
      transition: filter var(--dur) var(--ease);
    }
    .slider-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .slider-val { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
    .css-code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px; color: var(--muted); word-break: break-all;
    }
  </style>

  <script>
    import { onPageReady, markReady } from '../scripts/init';

    type Adjust = { brightness: number; contrast: number; saturate: number; hue: number };

    const PRESETS: Record<string, Adjust> = {
      none: { brightness: 100, contrast: 100, saturate: 100, hue: 0 },
      film: { brightness: 106, contrast: 88, saturate: 78, hue: 14 },
      bw: { brightness: 102, contrast: 112, saturate: 0, hue: 0 },
      vivid: { brightness: 100, contrast: 118, saturate: 165, hue: 0 },
    };

    function initPhotoDemo() {
      const card = document.querySelector<HTMLElement>('.photo-lab');
      if (!markReady(card)) return;

      const photo = document.getElementById('photo');
      const cssOut = document.getElementById('css-out');
      if (!photo || !cssOut) return;

      const keys = ['brightness', 'contrast', 'saturate', 'hue'] as const;
      const sliders = {} as Record<(typeof keys)[number], HTMLInputElement>;
      const labels = {} as Record<(typeof keys)[number], HTMLElement>;
      for (const key of keys) {
        const input = document.getElementById(key) as HTMLInputElement | null;
        const label = document.getElementById(`v-${key}`);
        if (!input || !label) return;
        sliders[key] = input;
        labels[key] = label;
      }

      function apply() {
        const values = {
          brightness: sliders.brightness.value,
          contrast: sliders.contrast.value,
          saturate: sliders.saturate.value,
          hue: sliders.hue.value,
        };
        for (const key of keys) labels[key].textContent = values[key];
        const filter =
          `brightness(${values.brightness}%) contrast(${values.contrast}%) ` +
          `saturate(${values.saturate}%) hue-rotate(${values.hue}deg)`;
        (photo as unknown as HTMLElement).style.filter = filter;
        cssOut!.textContent = 'filter: ' + filter;
      }

      for (const key of keys) sliders[key].addEventListener('input', apply);

      const chips = document.querySelectorAll<HTMLElement>('.chip[data-preset]');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const preset = PRESETS[chip.dataset.preset ?? 'none'] ?? PRESETS.none;
          for (const key of keys) sliders[key].value = String(preset[key]);
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          apply();
        });
      });

      document.getElementById('reset')?.addEventListener('click', () => {
        document.querySelector<HTMLElement>('.chip[data-preset="none"]')?.click();
      });

      apply();
    }

    onPageReady(initPhotoDemo);
  </script>
