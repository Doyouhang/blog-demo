---
// 随机选书器：原本占满整个读书页，现在降为书架底部的折叠彩蛋。
// 容器类换成 .book-picker，理由同 MiniPiano。
import Icon from './Icon.astro';
---
  <div class="demo-card book-picker">
    <div id="book" class="demo-result" aria-live="polite">
      <div class="result-icon"><Icon name="book" size={34} /></div>
      <div style="margin-top:8px;color:var(--muted)">点下面的按钮，从我的书架抽一本</div>
    </div>
    <div class="demo-row" style="justify-content:center">
      <button id="pick" class="demo-btn" type="button"><Icon name="dice" size={16} />帮我挑一本</button>
    </div>
    <p class="demo-hint center">
      书架共 <span id="count">0</span> 本，都是我想读或读过的。
    </p>
  </div>

  <style>
    .demo-result .book-title { font-size: 20px; font-weight: 700; margin-top: 8px; }
    .demo-result .book-author { color: var(--muted); font-size: 14px; margin-top: 4px; }
  </style>

  <script>
    import { onPageReady, markReady } from '../scripts/init';

    const BOOKS = [
      { title: '人类简史', author: '尤瓦尔·赫拉利', category: '社科' },
      { title: '枪炮、病菌与钢铁', author: '贾雷德·戴蒙德', category: '历史' },
      { title: '三体', author: '刘慈欣', category: '科幻' },
      { title: '基地', author: '艾萨克·阿西莫夫', category: '科幻' },
      { title: '置身事内', author: '兰小欢', category: '社科' },
      { title: '万历十五年', author: '黄仁宇', category: '历史' },
      { title: '你一生的故事', author: '特德·姜', category: '科幻' },
      { title: '乡土中国', author: '费孝通', category: '社科' },
      { title: '银河系搭车客指南', author: '道格拉斯·亚当斯', category: '科幻' },
      { title: '叫魂', author: '孔飞力', category: '历史' },
    ];

    function initReadingDemo() {
      const card = document.querySelector<HTMLElement>('.book-picker');
      if (!markReady(card)) return;

      const book = document.getElementById('book');
      const pickBtn = document.getElementById('pick');
      const count = document.getElementById('count');
      if (!book || !pickBtn || !count) return;

      count.textContent = String(BOOKS.length);
      // 先把初始图标存一份，后面每次重建内容都从它克隆
      const iconTemplate = book.querySelector('.result-icon');
      let last = -1;

      pickBtn.addEventListener('click', () => {
        let i = Math.floor(Math.random() * BOOKS.length);
        if (i === last) i = (i + 1) % BOOKS.length;
        last = i;
        const b = BOOKS[i];

        // 重建内容，让 .demo-result 的入场动画重新播一遍
        const icon = iconTemplate?.cloneNode(true);
        book.replaceChildren();
        if (icon) book.append(icon);
        const title = document.createElement('div');
        title.className = 'book-title';
        title.textContent = `《${b.title}》`;
        const author = document.createElement('div');
        author.className = 'book-author';
        author.textContent = `${b.author} · ${b.category}`;
        book.append(title, author);
      });
    }

    onPageReady(initReadingDemo);
  </script>
