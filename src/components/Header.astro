---
import Icon from './Icon.astro';

const B = import.meta.env.BASE_URL;
const nav = [
  { href: `${B}`, label: '首页' },
  { href: `${B}blog/`, label: '博客' },
  { href: `${B}moments/`, label: '此间' },
  { href: `${B}sparks/`, label: '闪念' },
  { href: `${B}interests/`, label: '兴趣' },
  { href: `${B}design/`, label: '设计' },
  { href: `${B}about/`, label: '关于' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === B ? path === B : path.startsWith(href));
---
<header class="site">
  <nav class="nav" aria-label="主导航">
    <a class="brand" href={`${B}`}><span class="seal" aria-hidden="true">迩</span>迩迩的小站</a>
    <div class="nav-right">
      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>
      <a
        class="theme-toggle"
        href={`${B}search/`}
        aria-label="搜索站内内容"
        title="搜索"
        aria-current={path.startsWith(`${B}search`) ? 'page' : undefined}
      >
        <Icon name="search" size={16} />
      </a>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="切换深色 / 浅色主题"
        title="切换深色 / 浅色主题"
      >
        <span class="icon-light"><Icon name="sun" size={16} /></span>
        <span class="icon-dark"><Icon name="moon" size={16} /></span>
      </button>
    </div>
  </nav>
</header>

<script>
  import { onPageReady, markReady } from '../scripts/init';

  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || !markReady(btn)) return;
    btn.addEventListener('click', (e) => {
      const root = document.documentElement;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* 存不下就只在本页生效，不影响使用 */
        }
      };
      // 从点击处圆形展开是仪式；不支持或减少动态时回退原来的淡入，不硬追
      const canReveal = typeof document.startViewTransition === 'function'
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!canReveal) { apply(); return; }
      const x = e.clientX || innerWidth / 2;
      const y = e.clientY || innerHeight / 2;
      root.classList.add('theme-reveal');
      const vt = document.startViewTransition(apply);
      vt.ready.then(() => {
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          { duration: 450, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
        );
      }).catch(() => {}).finally(() => {
        vt.finished.catch(() => {}).finally(() => root.classList.remove('theme-reveal'));
      });
    });
  }
  onPageReady(initThemeToggle);
</script>
