---
const B = import.meta.env.BASE_URL;
const nav = [
  { href: `${B}`, label: '首页' },
  { href: `${B}blog/`, label: '博客' },
  { href: `${B}interests/`, label: '兴趣' },
  { href: `${B}about/`, label: '关于' },
];
---
<header class="site">
  <nav class="nav">
    <a class="brand" href={`${B}`}>迩迩的小站</a>
    <div class="nav-links">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>
</header>
