---
// 侧栏标签云：带篇数，当前标签高亮
interface Props {
  tags: { tag: string; count: number }[];
  current?: string;
}
const { tags, current } = Astro.props;
const B = import.meta.env.BASE_URL;
---
<div class="tag-cloud">
  {tags.map(({ tag, count }) => (
    <a
      class:list={['tag-chip', tag === current && 'on']}
      href={`${B}blog/tags/${encodeURIComponent(tag)}/`}
      aria-current={tag === current ? 'page' : undefined}
    >
      {tag}<span class="n">{count}</span>
    </a>
  ))}
</div>
