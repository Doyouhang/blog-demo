---
// 兴趣卡（列表页用）。图标底衬和 demo 页头部保持一致，让列表页和详情页是同一套语言。
import Icon from './Icon.astro';
import type { Interest } from '../data/interests';

interface Props {
  interest: Interest;
}
const { interest } = Astro.props;
const B = import.meta.env.BASE_URL;
---
<a class="interest-card reveal" href={`${B}interests/${interest.slug}/`}>
  <span class="interest-icon" transition:name={`interest-${interest.title}`}>
    <Icon name={interest.icon} size={26} />
  </span>
  <h3>{interest.title}</h3>
  <p>{interest.desc}</p>
  <div class="interest-tags">{interest.tags.map((t) => <span class="tag">{t}</span>)}</div>
  <span class="interest-cta">进去玩 →</span>
</a>
