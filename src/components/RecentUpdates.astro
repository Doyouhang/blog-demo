---
// 首页的「最近更新」：把四种内容合成一条流。
//
// 原来这块只放长文 —— 于是首页只有在写长文的时候才会动，而长文恰恰是
// 最不常写的那种。合流之后，加一条闪念、换一张封面、发一组照片，首页都会变。
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { cstISODate } from '../utils/cst';

interface Props {
  /** 取最近几条 */
  limit?: number;
}
const { limit = 6 } = Astro.props;
const B = import.meta.env.BASE_URL;

const [essays, items, moments, sparks] = await Promise.all([
  getCollection('essays', ({ data }) => !data.draft),
  getCollection('items', ({ data }) => !data.draft),
  getCollection('moments', ({ data }) => !data.draft),
  getCollection('sparks', ({ data }) => !data.draft),
]);

// 被收藏条目关联的长文不再单独占一行。《奥德赛》和它的观后感《文明的归家路》
// 是同一件事 —— 同一天、同一句摘要，并排出现纯属重复。保留条目那一行：
// 它有封面，也更接近"我看了什么"这个事实。
const linked = new Set(
  items.map((i) => i.data.essay?.id).filter((id): id is string => !!id)
);

/** 截到 max 个字，超了补省略号 */
const clip = (s: string, max: number) => (s.length > max ? s.slice(0, max) + '…' : s);

/**
 * 一段正文拆成「首行 + 其余」。
 *
 * 闪念和动态都没有 title，正文既当标题又当摘要。原来整段折成一行塞进标题里，
 * 而标题是 nowrap 的 —— 换行之后的内容会被省略号整个吃掉，看起来就像丢了。
 */
function split(text: string, headMax = 40, tailMax = 52): [string, string] {
  const lines = String(text ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
  return [clip(lines[0] ?? '', headMax), clip(lines.slice(1).join('  '), tailMax)];
}

/** 单段文字压成一行（收藏的短评可能有换行，摘要位置不需要保留） */
const flat = (s: string, max = 52) => clip(String(s ?? '').replace(/\s+/g, ' ').trim(), max);

const KIND = {
  book: { label: '读书', page: 'reading' },
  movie: { label: '影视', page: 'watching' },
  song: { label: '音乐', page: 'music' },
};

interface Row {
  date: Date; label: string; title: string; note?: string;
  href: string; cover?: ImageMetadata;
}

const rows: Row[] = [
  ...essays
    .filter((e) => !linked.has(e.id))
    .map((e) => ({
      date: e.data.pubDate, label: '长文', title: e.data.title,
      note: flat(e.data.description), href: `${B}blog/${e.id}/`,
    })),
  ...items.map((i) => ({
    date: i.data.date, label: KIND[i.data.kind].label,
    title: i.data.kind === 'song' ? i.data.title : `《${i.data.title}》`,
    note: flat(i.data.blurb), href: `${B}interests/${KIND[i.data.kind].page}/`,
    cover: i.data.cover,
  })),
  ...moments.map((m) => {
    const [head, tail] = split(m.body ?? '');
    return {
      date: m.data.date, label: '此间', title: m.data.place ?? (head || '随手拍'),
      note: m.data.place ? head : tail, href: `${B}moments/`,
      cover: m.data.photos[0]?.src,
    };
  }),
  ...sparks.map((s) => {
    const [head, tail] = split(s.body ?? '', 44);
    return { date: s.data.date, label: '闪念', title: head, note: tail, href: `${B}sparks/` };
  }),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, limit);
---
<div class="upds">
  {rows.map((r) => (
    <a class="upd" href={r.href}>
      {r.cover ? (
        <Image class="upd-thumb" src={r.cover} alt="" width={132} />
      ) : (
        /* 没有封面的那一格：稿纸。
           它必须**不带任何信息** —— 类型已经写在旁边的标签上了，方块里再放
           一个字（试过「文」「念」）就是重复，而重复的装饰只会变成噪音。
           所以这里只有纹理，aria-hidden，它唯一的职责是让这一行不空、
           并且让所有标题落在同一条竖线上。 */
        <span class="upd-thumb upd-paper" aria-hidden="true"></span>
      )}
      <span class="upd-body">
        <span class="upd-hd">
          <span class="upd-tag">{r.label}</span>
          <time datetime={cstISODate(r.date)}>{cstISODate(r.date)}</time>
        </span>
        <b>{r.title}</b>
        {r.note && <span class="upd-note">{r.note}</span>}
      </span>
    </a>
  ))}
</div>

<style>
  .upds { display: flex; flex-direction: column; }
  .upd {
    display: grid; grid-template-columns: 66px 1fr; gap: 16px; align-items: center;
    padding: 14px 0; border-bottom: 1px solid var(--border); color: inherit;
  }
  .upd:last-child { border-bottom: 0; }
  .upd:hover { text-decoration: none; }
  .upd:hover b { color: var(--accent); }

  /* 封面比例各不相同（书是竖的、歌是方的），统一裁进一个固定的框，
     一排扫下来标题才在同一条竖线上 */
  /* 这里必须用 background-color 而不是 background 简写：简写会把
     .upd-paper 设的 background-image 一起清成 none，而这条规则的特异性
     比它高一级。踩过一次，横格画了但一直看不见 */
  .upd :global(.upd-thumb) {
    width: 66px; height: 66px; border-radius: var(--radius); display: block;
    object-fit: cover; background-color: var(--bg-soft); border: 1px solid var(--border);
  }
  /* 一页信笺：横格 + 左边那道朱红栏线。
     选它而不是格子或者空框，是因为它语义正好 —— 没有封面的就是长文和闪念，
     本来就是「一页写着字的纸」。而且它有块面感，和旁边有封面的行节奏是齐的。 */
  .upd-paper {
    position: relative;
    /* 两行 background-image 是一对：老浏览器解析不了 color-mix 会退回上一行，
       只剩纸色，不会整块塌掉 */
    background-image:
      repeating-linear-gradient(to bottom, transparent 0 13px, var(--border) 13px 14px);
    background-image:
      repeating-linear-gradient(to bottom, transparent 0 13px,
        color-mix(in srgb, var(--muted) 26%, transparent) 13px 14px);
    background-position: 0 6px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  /* 栏线。朱红是全站唯一的点缀色，这里只给一丝 */
  .upd-paper::after {
    content: ''; position: absolute; left: 11px; top: 8px; bottom: 8px; width: 1px;
    background: var(--seal); opacity: 0.5;
    transition: opacity var(--dur) var(--ease);
  }
  .upd:hover .upd-paper { border-color: var(--accent-line); }
  .upd:hover .upd-paper::after { opacity: 0.85; }

  .upd-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .upd-hd {
    display: flex; align-items: baseline; gap: 10px;
    font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .upd-tag {
    color: var(--accent); background: var(--accent-weak);
    border-radius: 999px; padding: 1px 9px; font-size: 11px;
  }
  .upd b {
    font-size: 15px; font-weight: 600;
    transition: color var(--dur-fast) var(--ease);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .upd-note {
    font-size: 13px; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  @media (max-width: 720px) {
    .upd { grid-template-columns: 52px 1fr; gap: 12px; }
    .upd :global(.upd-thumb) { width: 52px; height: 52px; }
    /* 52px 上格距跟着缩，不然只剩三条线像划痕 */
    .upd-paper {
      background-image:
        repeating-linear-gradient(to bottom, transparent 0 11px,
          color-mix(in srgb, var(--muted) 26%, transparent) 11px 12px);
      background-position: 0 5px;
    }
    .upd-paper::after { left: 9px; top: 6px; bottom: 6px; }
  }
</style>
