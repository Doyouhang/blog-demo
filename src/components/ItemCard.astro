---
// 收藏条目卡：歌、书、影视共用。
// 没封面的条目留出等宽空位而不是顶到最左 —— 列表里有封面没封面混排时，
// 标题不在同一条竖线上会很难扫。留白但不画假的占位封面。
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'items'>;
  /** 关联长文的链接，由调用方解析好传进来（关联只存在 item 一侧） */
  essayHref?: string;
}
const { item, essayHref } = Astro.props;
const { kind, title, creator, cover, date, rating, blurb, status } = item.data;

// 同一组状态，书和影视的说法不一样；歌没有状态
const STATUS_LABEL = {
  book: { want: '想读', doing: '在读', done: '读完' },
  movie: { want: '想看', doing: '在看', done: '看完' },
} as const;
const statusLabel = status ? STATUS_LABEL[kind === 'movie' ? 'movie' : 'book'][status] : null;

// blurb 名义上是「一句话」，实际难免有人往里写一整篇。
// 换行必须保留（敲了回车就该断行），但整篇铺开会把片单撑成一条长溜，
// 所以长的收进折叠里，预览第一行。
const text = String(blurb ?? '');
const lines = text.split('\n');
const isLong = text.length > 140 || lines.filter((l) => l.trim()).length > 4;
const peek = lines.find((l) => l.trim()) ?? '';
const when = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
---
<article class:list={['item', !cover && 'item-bare']}>
  {cover && (
    <div class="item-cover">
      <Image src={cover} alt={`《${title}》${kind === "movie" ? "海报" : "封面"}`} width={160} height={213} />
    </div>
  )}
  <div class="item-body">
    <h3>
      {kind === 'song' ? title : `《${title}》`}
      {statusLabel && <span class="badge">{statusLabel}</span>}
    </h3>
    <p class="meta">
      <span>{creator}</span>
      <span class="dot">·</span>
      <span>{when}</span>
      {rating != null && (
        <>
          <span class="dot">·</span>
          <span class="rate" title={`${rating} 分（满分 5）`} aria-label={`评分 ${rating} 分，满分 5 分`}>
            {Array.from({ length: 5 }, (_, i) => (
              <i class:list={['pip', i < rating && 'on']} aria-hidden="true"></i>
            ))}
          </span>
        </>
      )}
    </p>
    {isLong ? (
      <details class="blurb-fold">
        <summary>
          <span class="peek">{peek.length > 56 ? peek.slice(0, 56) + '…' : peek}</span>
          <span class="fold-hint"></span>
        </summary>
        <p class="blurb">{text}</p>
      </details>
    ) : (
      <p class="blurb">{text}</p>
    )}
    {essayHref && <a class="more" href={essayHref}>写了点感想 →</a>}
  </div>
</article>

<style>
  .item {
    display: flex; gap: 16px;
    padding: 16px 0; border-bottom: 1px solid var(--border);
  }
  .item-cover { flex: 0 0 80px; }
  .item-cover :global(img) {
    width: 80px; height: auto; border-radius: 8px; display: block;
    border: 1px solid var(--border);
  }
  /* 无封面：留出与封面等宽的空位，保证标题左边缘对齐 */
  .item-bare { padding-left: 96px; }
  .item-body { min-width: 0; flex: 1; }
  .item h3 {
    margin: 0 0 6px; font-size: 16px; font-weight: 600;
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  }
  .badge {
    font-size: 11px; font-weight: 500; color: var(--muted);
    border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px;
  }
  .meta {
    margin: 0 0 8px; color: var(--muted); font-size: 13px;
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .dot { opacity: .5; }
  .rate { display: inline-flex; gap: 3px; align-items: center; }
  .pip {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--border);
  }
  .pip.on { background: var(--accent); }
  /* 保留换行：写的时候敲了回车，页面上就该断行。
     不加这条的话浏览器把换行折成空格，一首诗会变成一整段。 */
  .blurb { margin: 0; font-size: 14px; line-height: 1.7; white-space: pre-wrap; }
  .blurb-fold summary {
    cursor: pointer; font-size: 14px; line-height: 1.7;
    color: var(--muted); list-style: none; display: flex; gap: 6px;
    align-items: baseline; flex-wrap: wrap;
  }
  .blurb-fold summary::-webkit-details-marker { display: none; }
  .blurb-fold .fold-hint { color: var(--accent); font-size: 13px; white-space: nowrap; }
  .blurb-fold .fold-hint::after { content: '展开'; }
  .blurb-fold[open] .fold-hint::after { content: '收起'; }
  .blurb-fold[open] .peek { display: none; }
  .blurb-fold[open] summary { margin-bottom: 6px; }
  .more {
    display: inline-block; margin-top: 8px; font-size: 13px;
    color: var(--accent); text-decoration: none;
  }
  .more:hover { text-decoration: underline; }
</style>
