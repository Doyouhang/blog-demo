---
import BaseLayout from '../layouts/BaseLayout.astro';
const B = import.meta.env.BASE_URL;

// 暂不公开邮箱：留空时下面那一行不渲染，页面不会有占位符残留。
// 想放出来就填进来；介意被爬虫收走的话可以写成 "迩迩 [at] example [dot] com" 这种形式。
const EMAIL = '';
---
<BaseLayout title="关于" description="关于我">
  <article>
    <h1>关于我</h1>
    <p>你好，我是迩迩，一个喜欢折腾技术和记录生活的人。</p>
    <p>
      这个站点用 <a href="https://astro.build">Astro</a> 搭建，源码托管在 GitHub，
      通过 GitHub Pages 免费上线。你可以<a href={`${B}blog/`}>读读我的博客</a>，
      或者看看<a href={`${B}interests/`}>我的兴趣</a>。
    </p>
    <h2>联系方式</h2>
    <ul>
      {EMAIL && <li>邮箱：<a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>}
      <li>GitHub：<a href="https://github.com/Doyouhang">@Doyouhang</a></li>
      <li>订阅：<a href={`${B}rss.xml`}>RSS</a></li>
    </ul>
  </article>
</BaseLayout>
