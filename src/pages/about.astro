---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

// 暂不公开邮箱：留空时下面那一行不渲染，页面不会有占位符残留。
// 想放出来就填进来；介意被爬虫收走的话可以写成 "迩迩 [at] example [dot] com" 这种形式。
const EMAIL = '';
const B = import.meta.env.BASE_URL;
---
<BaseLayout title="关于" description="关于我，以及这个站是什么、怎么搭的" fullWidth>
  <div class="container-wide">
    <PageHeader
      eyebrow="关于"
      title="关于我"
      lead="读过的书、看过的片、走过的路，以及一些一闪而过的念头。"
    />
    <div class="split">
      <div class="split-main prose">
        <p>
          我是迩迩，一名软件工程师。这个站是我给自己留的一份档案。
        </p>
        <p>
          起念很简单：读过的书、看过的片、走过的路，当时都想过些什么，不写下来就会散掉。
          与其写一句「我喜欢读书」，不如把读过的书和当时的想法一并摆出来 ——
          记录学习的过程，梳理自己的想法，顺便练一练怎么把话说清楚。
        </p>

        <h2>这里有什么</h2>
        <p>
          <a href={`${B}blog/`}>博客</a>放值得展开讲的东西，一篇是一篇。
          <a href={`${B}sparks/`}>闪念</a>放撑不起标题的那些 —— 一句话、一个念头，一种文艺病。
          <a href={`${B}moments/`}>此间</a>是出门随手拍的照片，配一段话，
          连快门光圈一起存着。
          <a href={`${B}interests/`}>兴趣</a>是书架、片单和歌单，另外还有股票、代码、下厨
          这几件仍在琢磨的事。
        </p>


        <blockquote>慢慢来，比较快。</blockquote>
      </div>
      <aside>
        <section class="side-box">
          <h2>找到我</h2>
          {EMAIL && (
            <div class="side-row">
              <Icon name="book" size={18} />
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </div>
          )}
          <div class="side-row">
            <Icon name="github" size={18} />
            <a href="https://github.com/Doyouhang">@Doyouhang</a>
          </div>
        </section>
        <section class="side-box">
          <h2>Colophon</h2>
          <div class="side-row"><span>标题字</span><span class="side-val">PaperSerif</span></div>
          <div class="side-row"><span>正文字</span><span class="side-val">系统无衬线</span></div>
          <div class="side-row"><span>戳记</span><span class="side-val">等宽</span></div>
          <div class="side-row">
            <span>配色</span>
            <span class="side-val swatches">
              <i style="--c:#f5f3ee" title="纸 #f5f3ee"></i><i style="--c:#23262b" title="墨 #23262b"></i><i style="--c:#2f4d7e" title="藏青 #2f4d7e"></i><i style="--c:#bf3b2b" title="朱红 #bf3b2b"></i>
            </span>
          </div>
          <p class="side-foot">衬线取 Noto Serif SC 子集自托管。</p>
        </section>
        <section class="side-box">
          <h2>站点</h2>
          <div class="side-row"><span>框架</span><span class="side-val">Astro</span></div>
          <div class="side-row"><span>托管</span><span class="side-val">GitHub Pages</span></div>
          <div class="side-row"><span>主题</span><span class="side-val">跟随系统，可切换</span></div>
          <div class="side-row">
            <span>源码</span>
            <span class="side-val"><a href="https://github.com/Doyouhang/blog-demo">blog-demo</a></span>
          </div>
          <p class="side-foot">静态生成，无后端、无追踪脚本。</p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
