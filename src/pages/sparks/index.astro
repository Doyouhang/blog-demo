---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import { cstYear, cstYearMonth, cstMonthDay, cstTime, cstISODate } from '../../utils/cst';

const B = import.meta.env.BASE_URL;

const all = (await getCollection('sparks', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// render() 只能在页面这层 await，组件里做不了
const rendered = await Promise.all(
  all.map(async (s) => {
    const body = s.body ?? '';
    return {
      spark: s,
      Content: (await render(s)).Content,
      // 绝大多数闪念就一两句；偶尔一条长的会把整条时间线撑断，折起来
      long: body.replace(/\s/g, '').length > 200,
      peek: (body.split('\n').find((l) => l.trim()) ?? '').trim(),
    };
  })
);

// 按年月分组，跨度才读得出来
const groups = new Map<string, typeof rendered>();
for (const r of rendered) {
  const key = cstYearMonth(r.spark.data.date);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(r);
}

const years = [...new Set(all.map((s) => cstYear(s.data.date)))].sort((a, b) => b - a);
const span = years.length > 1 ? `${years[years.length - 1]}–${years[0]}` : String(years[0] ?? '');
---
<BaseLayout title="闪念" description="想到什么记什么：一句话、一个念头、一段读完之后的反应。">
  <div class="container">
    <PageHeader
      eyebrow={all.length ? `${all.length} 条 · ${span}` : '时间线'}
      title="闪念"
      lead="想到什么记什么。大多是一句话，偶尔写长一点。没有主题，按时间排。"
    />

    {all.length === 0 ? (
      <p class="empty">还没有记录。在 <code>src/content/sparks/</code> 下新建一个 md 就行。</p>
    ) : (
      <div class="stream">
        {[...groups].map(([month, list]) => (
          <section class="month">
            <h2 class="month-hd">{month}</h2>
            {list.map(({ spark, Content, long, peek }) => (
              <article class="jot" id={cstISODate(spark.data.date)}>
                <div class="when">
                  <span class="d">{cstMonthDay(spark.data.date)}</span>
                  {cstTime(spark.data.date) && <span class="t">{cstTime(spark.data.date)}</span>}
                </div>
                {long ? (
                  <details class="fold">
                    <summary>
                      <span class="peek">{peek.length > 34 ? peek.slice(0, 34) + '…' : peek}</span>
                      <span class="fold-hint"></span>
                    </summary>
                    <div class="body"><Content /></div>
                  </details>
                ) : (
                  <div class="body"><Content /></div>
                )}
              </article>
            ))}
          </section>
        ))}
      </div>
    )}

    {years.length > 0 && (
      <nav class="years" aria-label="年度回顾">
        {years.map((y) => <a href={`${B}year/${y}/`}>{y} 年回顾 →</a>)}
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .month + .month { margin-top: 8px; }
  .month-hd {
    font-size: 13px; font-weight: 600; color: var(--muted);
    margin: 34px 0 0; padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .month:first-child .month-hd { margin-top: 0; }

  /* global.css:349 给 article 定了 720px 的正文行宽并居中 —— 那是给长文用的。
     这里的条目要和月份标题左右对齐，不然分隔线会错开一截 */
  .jot {
    max-width: none; margin: 0;
    display: grid; grid-template-columns: 86px 1fr; gap: 18px;
    padding: 18px 0; border-bottom: 1px solid var(--border);
  }
  .month:last-child .jot:last-child { border-bottom: 0; }
  .when {
    display: flex; flex-direction: column; gap: 2px; padding-top: 3px;
    font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .when .t { font-size: 12px; opacity: .7; }

  /* Markdown 会把单个换行并成空格，但这些句子的断行本身就是作者的语气
     （诗、清单、加缪那段引文），所以保留原样 */
  .body { font-size: 15px; line-height: 1.9; }
  .body :global(p) { margin: 0; white-space: pre-wrap; }
  .body :global(p + p) { margin-top: 14px; }

  /* 折叠：和收藏卡片的长短评用同一套手势 */
  .fold summary {
    cursor: pointer; list-style: none; display: flex; gap: 8px;
    align-items: baseline; flex-wrap: wrap;
    font-size: 15px; line-height: 1.9; color: var(--muted);
  }
  .fold summary::-webkit-details-marker { display: none; }
  .fold .fold-hint { color: var(--accent); font-size: 13px; white-space: nowrap; }
  .fold .fold-hint::after { content: '展开'; }
  .fold[open] .fold-hint::after { content: '收起'; }
  .fold[open] .peek { display: none; }
  .fold[open] summary { margin-bottom: 10px; }

  .years {
    display: flex; flex-wrap: wrap; gap: 14px;
    margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border);
  }
  .years a { color: var(--muted); text-decoration: none; font-size: 13px; padding: 3px 0; display: inline-block; }
  .years a:hover { color: var(--accent); }

  .empty { color: var(--muted); text-align: center; padding: 60px 20px; }
  .empty code {
    background: var(--code-bg); padding: 1px 6px; border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;
  }

  /* ===== 悬停 ===== */
  /* 提亮块用伪元素铺，不能直接给 .jot 加 margin-inline/padding-inline ——
     那样底部分隔线会比月份标题的横线宽出 24px，两条线对不齐。
     这正是文件开头那条注释在讲的坑，别再踩一次。 */
  .jot { position: relative; z-index: 0; }
  .jot::after {
    content: ''; position: absolute; inset: 6px -12px; z-index: -1;
    border-radius: 8px; background: transparent; pointer-events: none;
    transition: background var(--dur) var(--ease);
  }
  .jot:hover::after { background: var(--bg-soft); }
  .when { transition: color var(--dur-fast) var(--ease); }
  .jot:hover .when { color: var(--seal); }

  /* ===== 展开/收起做成滑动 ===== */
  /* interpolate-size 是可继承属性，写在 .fold 上就够，::details-content 会继承。
     少了它，block-size 到 auto 不可插值，展开是「跳」不是「滑」。 */
  .fold { interpolate-size: allow-keywords; }
  .fold :global(::details-content) {
    block-size: 0; overflow: clip;
    transition: block-size var(--dur) var(--ease), content-visibility var(--dur) allow-discrete;
  }
  .fold[open] :global(::details-content) { block-size: auto; }

  /* ===== 进场：整条淡入上浮，日期左边的灯泡错开 80ms 再亮 ===== */
  /* 读起来是「内容到位，然后灵感一闪」，两件事同时发生反而糊成一团。
     灯泡这个意象跟「最近更新」里闪念用的图标是同一套。 */
  .when::before {
    content: ''; position: absolute; left: -14px; top: 9px;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--seal); opacity: .3;
  }
  /* 初始隐藏态只在 html.jot-motion 下生效，而这个类是脚本加的 ——
     脚本没跑、报错、被拦截，页面就是原来的样子。
     绝不能让「动效坏了」变成「内容看不见」。 */
  :global(html.jot-motion) .jot {
    opacity: 0; transform: translateY(10px);
    transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease-spring);
  }
  :global(html.jot-motion) .jot.seen { opacity: 1; transform: none; }
  :global(html.jot-motion) .jot.seen .when::before {
    animation: jot-bulb var(--dur-slow) var(--ease) 80ms both;
  }
  @keyframes jot-bulb {
    0%   { opacity: .25; box-shadow: 0 0 0 0 transparent; }
    55%  { opacity: 1;   box-shadow: 0 0 0 7px color-mix(in srgb, var(--seal) 26%, transparent); }
    100% { opacity: .9;  box-shadow: 0 0 0 0 transparent; }
  }

  /* 打印：没滚到的条目此刻还是隐藏态，不兜住的话会印出整页空白 */
  @media print {
    :global(html.jot-motion) .jot { opacity: 1 !important; transform: none !important; }
    .when::before { display: none; }
  }

  /* 系统说要减弱动态效果：脚本压根不会加 jot-motion，这里再兜一层，
     把悬停和展开的过渡也一并停掉 */
  @media (prefers-reduced-motion: reduce) {
    .jot::after, .when, .fold :global(::details-content) { transition: none; }
    :global(html.jot-motion) .jot { opacity: 1; transform: none; transition: none; }
    :global(html.jot-motion) .jot.seen .when::before { animation: none; }
  }

  @media (max-width: 560px) {
    .jot { grid-template-columns: 1fr; gap: 6px; }
    .when { flex-direction: row; gap: 8px; padding-top: 0; }
  }
  @media (max-width: 560px) {
    /* 窄屏日期和正文并成一行，灯泡挪不出左边距，收起来 */
    .when::before { display: none; }
  }
</style>

<script>
  import { onPageReady, markReady } from '../../scripts/init';

  // 进场动效：脚本只负责在合适的时候打 .seen，动画本身交给 CSS。
  //
  // 为什么不用 IntersectionObserver：IO 只在「相交状态发生变化」时回调。
  // 瞬时跳转（RSS 的 /sparks/#日期 深链、Cmd+↓、页内搜索、恢复滚动位置）
  // 会让元素从「在下面」直接变成「在上面」，相交比例全程是 0，一次回调都不发 ——
  // 那些条目就永久停在 opacity: 0。页面照样 200，控制台一声不吭。
  // 量过：瞬时跳到页底，最差 opacity = 0，整屏内容是空的。
  //
  // 为什么不用 animation-timeline: view()（滚动驱动）：它的进度绑在
  // 「元素还能滚多远」上，而页面最后几条下面没内容可滚，会永久停在中间态；
  // 想靠缩短范围躲开，动画又全程发生在视口底边之外，等于没有。两头堵死。
  //
  // 条目就几十个，每帧读一遍位置的成本可以忽略，换来的是任何滚法都不丢内容。
  function initJots() {
    const stream = document.querySelector('.stream') as HTMLElement | null;
    if (!markReady(stream)) return;
    // 系统要求减弱动态效果时，连隐藏态都不要加上
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = [...stream!.querySelectorAll('.jot')] as HTMLElement[];
    if (!items.length) return;
    document.documentElement.classList.add('jot-motion');

    // 两条线而不是一条，滞回防抖：
    //   进屏到 88% 高度  → 触发
    //   完全落到视口下方 → 复位，滚回来会重播
    // 共用一条线的话，元素停在线附近会反复闪；而且往回滚时内容会在眼前淡出。
    const IN = 0.88, OUT = 1;
    let ticking = false;
    const sweep = () => {
      ticking = false;
      // 换页之后这些节点已经不在文档里了，顺手把监听摘掉，别留着空转
      if (!stream!.isConnected) {
        removeEventListener('scroll', onScroll);
        removeEventListener('resize', onScroll);
        return;
      }
      const h = innerHeight;
      // 先把位置读完再改 class：读写交替会在一帧内反复触发重排
      const tops = items.map((el) => el.getBoundingClientRect().top);
      items.forEach((el, i) => {
        const seen = el.classList.contains('seen');
        if (!seen && tops[i] < h * IN) el.classList.add('seen');
        else if (seen && tops[i] > h * OUT) el.classList.remove('seen');
      });
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(sweep); }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    // 展开长条目会把下面的条目整体推走，位置变了要重算。toggle 不冒泡，得用捕获
    stream!.addEventListener('toggle', onScroll, true);
    sweep();
  }
  onPageReady(initJots);
</script>
