---
import InterestLayout from '../../../layouts/InterestLayout.astro';
---
<InterestLayout emoji="🍳" title="下厨" description="面食配比计算器：选个面种、输入面粉量，实时算出水和盐。">
  <div class="demo-card">
    <label class="demo-label">面种（决定含水量）</label>
    <div class="demo-row">
      <button class="chip active" data-hydra="50" data-name="手擀面">手擀面</button>
      <button class="chip" data-hydra="55" data-name="拉面">拉面</button>
      <button class="chip" data-hydra="45" data-name="饺子皮">饺子皮</button>
      <button class="chip" data-hydra="42" data-name="刀削面">刀削面</button>
    </div>

    <label class="demo-label" for="flour">面粉用量（克）</label>
    <input type="number" id="flour" min="50" max="2000" step="50" value="300" style="width:160px" />

    <div class="demo-result" style="margin-top:18px">
      <div style="font-size:30px">🍜</div>
      <div id="out" style="margin-top:10px;font-size:17px;line-height:2"></div>
    </div>
    <p class="demo-hint">💧 含水量 = 水 ÷ 面粉。数值是参考，手感还得自己找。</p>
  </div>

  <style>
    .demo-hint { color: var(--muted); font-size: 14px; margin: 14px 0 0; text-align: center; }
    #out b { color: var(--accent); }
  </style>

  <script>
    const flourInput = document.getElementById('flour') as HTMLInputElement;
    const out = document.getElementById('out') as HTMLElement;
    const chips = document.querySelectorAll<HTMLElement>('.chip[data-hydra]');

    let hydra = 50;
    let name = '手擀面';

    function calc() {
      const flour = Math.max(0, parseFloat(flourInput.value) || 0);
      const water = Math.round(flour * (hydra / 100));
      const salt = Math.round(flour * 0.01 * 10) / 10;
      out.innerHTML =
        '<b>' + name + '</b>（含水量 ' + hydra + '%）<br />' +
        '面粉 ' + flour + ' g → 水 <b>' + water + ' g</b> · 盐 <b>' + salt + ' g</b>';
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        hydra = parseInt(chip.dataset.hydra ?? '50', 10);
        name = chip.dataset.name ?? '面条';
        calc();
      });
    });

    flourInput.addEventListener('input', calc);
    calc();
  </script>
</InterestLayout>
