---
import InterestLayout from '../../../layouts/InterestLayout.astro';
import ItemCard from '../../../components/ItemCard.astro';
import DemoToggle from '../../../components/DemoToggle.astro';
import MiniPiano from '../../../components/MiniPiano.astro';
import { getCollection } from 'astro:content';

const B = import.meta.env.BASE_URL;

const songs = (await getCollection('items', ({ data }) => !data.draft && data.kind === 'song')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const stories = (await getCollection('essays', ({ data }) => !data.draft && data.topic === 'music')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 关联只存在 item 一侧，这里解析成链接传给卡片
const hrefOf = (id?: string) => (id ? `${B}blog/${id}/` : undefined);
---
<InterestLayout icon="headphones" title="音乐" description="循环过的歌攒成歌单，有故事的单独讲。">
  <div class="split">
    <div class="split-main">
      <div class="sec-hd">
        <h2>歌单</h2>
        <span class="sec-note">{songs.length} 首</span>
      </div>

      {songs.length === 0 ? (
        <p class="empty">歌单还是空的。在 <code>src/content/items/</code> 加一个 <code>kind: song</code> 的文件即可。</p>
      ) : (
        songs.map((s) => <ItemCard item={s} essayHref={hrefOf(s.data.essay?.id)} />)
      )}
    </div>

    <aside>
      <section class="side-box">
        <h2>音乐故事</h2>
        {stories.length === 0 ? (
          <p class="side-foot">还没写过。写一篇 <code>topic: music</code> 的长文就会出现在这里。</p>
        ) : (
          <>
            {stories.map((e) => (
              <div class="side-row">
                <a href={`${B}blog/${e.id}/`}>{e.data.title}</a>
              </div>
            ))}
            <p class="side-foot">共 {stories.length} 篇</p>
          </>
        )}
      </section>
    </aside>
  </div>

  <DemoToggle icon="play" label="顺手玩玩：迷你钢琴">
    <MiniPiano />
  </DemoToggle>
</InterestLayout>

<style>
  .empty { color: var(--muted); font-size: 14px; }
  .empty code, .side-foot code {
    background: var(--code-bg); padding: 1px 6px; border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;
  }
</style>
