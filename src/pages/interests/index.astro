---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import InterestCard from '../../components/InterestCard.astro';
import { interests } from '../../data/interests';
---
<BaseLayout title="兴趣" description="读的书、听的歌、盯的盘" fullWidth noIndex>
  <div class="container-wide">
    <PageHeader
      eyebrow={`${interests.length} 个兴趣`}
      title="兴趣分享"
      lead="工作之外的东西。读的书、听的歌、盯的盘，都记在这里。"
    />
    <div class="interest-grid">
      {interests.map((i) => <InterestCard interest={i} />)}
    </div>
  </div>
</BaseLayout>
