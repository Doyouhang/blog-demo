---
import InterestLayout from '../../../layouts/InterestLayout.astro';
import ItemCard from '../../../components/ItemCard.astro';
import DemoToggle from '../../../components/DemoToggle.astro';
import BookPicker from '../../../components/BookPicker.astro';
import { getCollection } from 'astro:content';

const B = import.meta.env.BASE_URL;

const books = (await getCollection('items', ({ data }) => !data.draft && data.kind === 'book')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const notes = (await getCollection('essays', ({ data }) => !data.draft && data.topic === 'reading')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 书架按状态分区。没填 status 的当作读完 —— 补录旧书时最省事的默认。
const SECTIONS = [
  { key: 'doing', label: '在读' },
  { key: 'done', label: '读完' },
  { key: 'want', label: '想读' },
] as const;
const shelf = SECTIONS.map((s) => ({
  ...s,
  list: books.filter((b) => (b.data.status ?? 'done') === s.key),
})).filter((s) => s.list.length > 0);

const thisYear = new Date().getFullYear();
const doneThisYear = books.filter(
  (b) => (b.data.status ?? 'done') === 'done' && b.data.date.getFullYear() === thisYear
).length;

const hrefOf = (id?: string) => (id ? `${B}blog/${id}/` : undefined);
---
<InterestLayout wide icon="book" title="读书" description="读到的书都记在书架上，值得说几句的会单写一篇。">
  <div class="split">
    <div class="split-main">
      {books.length === 0 ? (
        <p class="empty">暂未入档。<span class="empty-hint">书架还是空的。在 <code>src/content/items/</code> 加一个 <code>kind: book</code> 的文件即可。</span></p>
      ) : (
        shelf.map((s) => (
          <section class="shelf">
            <div class="sec-hd">
              <h2>{s.label}</h2>
              <span class="sec-note">{s.list.length} 本</span>
            </div>
            {s.list.map((b) => <ItemCard item={b} essayHref={hrefOf(b.data.essay?.id)} />)}
          </section>
        ))
      )}
    </div>

    <aside>
      <section class="side-box">
        <h2>今年</h2>
        <div class="side-row"><span>读完</span><span class="side-val">{doneThisYear} 本</span></div>
        <div class="side-row"><span>书架</span><span class="side-val">{books.length} 本</span></div>
      </section>

      <section class="side-box">
        <h2>读后感</h2>
        {notes.length === 0 ? (
          <p class="side-foot">还没写过。写一篇 <code>topic: reading</code> 的长文就会出现在这里。</p>
        ) : (
          <>
            {notes.map((e) => (
              <div class="side-row">
                <a href={`${B}blog/${e.id}/`}>{e.data.title}</a>
              </div>
            ))}
            <p class="side-foot">共 {notes.length} 篇</p>
          </>
        )}
      </section>
    </aside>
  </div>

  <DemoToggle icon="dice" label="顺手玩玩：随机选书">
    <BookPicker />
  </DemoToggle>
</InterestLayout>

<style>
  .shelf + .shelf { margin-top: 28px; }
  .empty { color: var(--muted); font-size: 14px; }
  .empty code, .side-foot code {
    background: var(--code-bg); padding: 1px 6px; border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;
  }
</style>
