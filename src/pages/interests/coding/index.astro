---
import InterestLayout from '../../../layouts/InterestLayout.astro';
import EssayCard from '../../../components/EssayCard.astro';
import DemoToggle from '../../../components/DemoToggle.astro';
import JsRunner from '../../../components/JsRunner.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('essays', ({ data }) => !data.draft && data.topic === 'coding')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 仓库从文章里反推，不另外维护一份列表 —— 两处各写一份必然有一天不同步。
// 同一个仓库可能对应好几篇，按地址去重，顺便记住写了几篇。
const repos = new Map<string, { url: string; name: string; posts: number }>();
for (const p of posts) {
  const url = p.data.repo;
  if (!url) continue;
  const name = url.replace(/\/+$/, '').split('/').slice(-2).join('/');
  const hit = repos.get(url);
  if (hit) hit.posts += 1;
  else repos.set(url, { url, name, posts: 1 });
}
const repoList = [...repos.values()].sort((a, b) => b.posts - a.posts);

const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
---
<InterestLayout
  wide
  icon="code"
  title="代码"
  description="写过的东西和踩过的坑。每篇尽量给出可复现的数字，而不是「据说这样更快」。"
>
  <div class="split">
    <div class="split-main">
      {posts.length === 0 ? (
        <p class="empty">
          还没有技术文章。写一篇 <code>topic: coding</code> 的长文就会出现在这里，
          填上 <code>repo</code> 字段还会在右边列出仓库。
        </p>
      ) : (
        posts.map((p) => <EssayCard post={p} />)
      )}
    </div>

    <aside>
      <section class="side-box">
        <h2>仓库</h2>
        {repoList.length === 0 ? (
          <p class="side-foot">文章里填了 <code>repo</code> 就会列在这里。</p>
        ) : (
          <>
            {repoList.map((r) => (
              <div class="side-row">
                <a href={r.url} rel="noopener noreferrer" target="_blank">
                  <Icon name="code" size={13} /> {r.name}
                </a>
                <span class="side-val">{r.posts} 篇</span>
              </div>
            ))}
            <p class="side-foot">共 {repoList.length} 个</p>
          </>
        )}
      </section>

      {topTags.length > 0 && (
        <section class="side-box">
          <h2>都在写什么</h2>
          {topTags.map(([tag, n]) => (
            <div class="side-row"><span>{tag}</span><span class="side-val">{n} 篇</span></div>
          ))}
          <p class="side-foot">共 {posts.length} 篇</p>
        </section>
      )}
    </aside>
  </div>

  <DemoToggle icon="play" label="顺手玩玩：迷你 JavaScript 运行器">
    <JsRunner />
  </DemoToggle>
</InterestLayout>

<style>
  .empty { color: var(--muted); font-size: 14px; line-height: 1.9; }
  .empty code, .side-foot code {
    background: var(--code-bg); padding: 1px 6px; border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;
  }
  .side-row a { display: inline-flex; align-items: center; gap: 6px; }
</style>
