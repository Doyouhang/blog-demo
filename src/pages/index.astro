---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import RecentUpdates from '../components/RecentUpdates.astro';
import { Image } from 'astro:assets';
import type { IconName } from '../components/icons';
import { getCollection } from 'astro:content';
import { interests } from '../data/interests';
import { AUTHOR } from '../consts';
import nowData from '../data/now.json';
import stockData from '../data/stocks.json';
import { cstISODate } from '../utils/cst';

const B = import.meta.env.BASE_URL;

const [rawItems, rawMoments, sparks] = await Promise.all([
  getCollection('items', ({ data }) => !data.draft),
  getCollection('moments', ({ data }) => !data.draft),
  getCollection('sparks', ({ data }) => !data.draft),
]);
const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();
const items = [...rawItems].sort(byNewest);
const moments = [...rawMoments].sort(byNewest);

// 首屏右边放最近一张照片。有相机、有照片，首页一张不放太浪费了
const heroMoment = moments[0];
const heroPhoto = heroMoment?.data.photos[0];

// 兴趣格子上放真封面：三个有收藏的兴趣各取最近一条。
// 剩下三个没有条目可取，退回图标 —— 六个格子的高度仍然一致
const KIND_OF: Record<string, 'book' | 'movie' | 'song'> = {
  reading: 'book', watching: 'movie', music: 'song',
};
const latestOf = (slug: string) => {
  const kind = KIND_OF[slug];
  return kind ? items.find((i) => i.data.kind === kind) ?? null : null;
};

// 「此刻」：能从内容里算出来的就不要手写 —— 手写的迟早停在某个日期上。
// now.json 留给算不出来的（在忙什么、在学什么），会接在自动那几条后面。
interface NowItem { icon: IconName; text: string }

// 「此刻」讲的是现在，不是总账。所以这里只收两种东西：
//   1. 明确标着「在读 / 在看」的状态 —— 那本身就是当下，不看日期
//   2. 最近一段时间里真的发生过的事 —— 看日期，过期就不说
// 累计数（书架多少本、攒了多少条闪念）被拿掉了：它们确实永远不会空，
// 但代价是这个盒子不再说明"现在"，随便哪天看都长一个样。
//
// 加了时间窗之后有些行会消失，那不是 bug —— 最新的一本书停在 2023 年、
// 最新的一条动态停在 2025 年，硬写「最近读完」「最近拍于」就是在骗人。
const DAY = 86400000;
const nowMs = Date.now();
const within = (d: Date, days: number) => nowMs - d.valueOf() <= days * DAY;
const LATELY = 30;   // 「最近……」的尺度
const JUST = 14;     // 「刚……」的尺度，要更近

const reading = items.find((i) => i.data.kind === 'book' && i.data.status === 'doing');
const watching = items.find((i) => i.data.kind === 'movie' && i.data.status === 'doing');
const doneBook = items.find((i) => i.data.kind === 'book' && within(i.data.date, LATELY));
const doneMovie = items.find((i) => i.data.kind === 'movie' && within(i.data.date, LATELY));
const lastSong = items.find((i) => i.data.kind === 'song' && within(i.data.date, LATELY));
const lastShot = heroMoment && within(heroMoment.data.date, LATELY) ? heroMoment : null;
const freshSparks = sparks.filter((s) => within(s.data.date, JUST)).length;

const nowRows: NowItem[] = [];
if (reading) nowRows.push({ icon: 'book', text: `在读《${reading.data.title}》` });
else if (doneBook) nowRows.push({ icon: 'book', text: `最近读完《${doneBook.data.title}》` });
if (watching) nowRows.push({ icon: 'play', text: `在看《${watching.data.title}》` });
else if (doneMovie) nowRows.push({ icon: 'play', text: `最近看完《${doneMovie.data.title}》` });
if (lastSong) nowRows.push({ icon: 'headphones', text: `最近在听 ${lastSong.data.title}` });
if (lastShot?.data.place) nowRows.push({ icon: 'camera', text: `最近拍于 ${lastShot.data.place}` });
if (freshSparks) nowRows.push({ icon: 'bulb', text: `刚更新 ${freshSparks} 条闪念` });
// now.json 留给自动算不出来的，接在后面
nowRows.push(...((nowData as { items?: NowItem[] }).items ?? []));

// 全站最新那条的时间。一条都没入选说明这阵子确实没动静 ——
// 与其空着，不如老实说上次是什么时候
const nowAt = [...items, ...moments, ...sparks]
  .map((e) => e.data.date.valueOf())
  .sort((a, b) => b - a)[0];
if (nowRows.length === 0 && nowAt) {
  nowRows.push({ icon: 'compass', text: `最近有点安静，上次记录是 ${cstISODate(new Date(nowAt))}` });
}

// 自选股：取涨跌幅绝对值最大的三只，另外用全部持仓画一排迷你柱
interface StockRow { code: string; name: string; ok: boolean; percent?: number }
const rows = (stockData as { rows: StockRow[] }).rows.filter((r) => r.ok && r.percent != null);
const movers = [...rows].sort((a, b) => Math.abs(b.percent!) - Math.abs(a.percent!)).slice(0, 3);
const maxAbs = Math.max(...rows.map((r) => Math.abs(r.percent!)), 0.5);
const dirOf = (n: number) => (n > 0 ? 'up' : n < 0 ? 'down' : 'flat');
const sign = (n: number) => (n > 0 ? '+' : '') + n.toFixed(2) + '%';
---
<BaseLayout fullWidth noIndex>
  <div class="container-wide">
    <section class="intro">
      <div class="avatar" aria-hidden="true">迩</div>
      <div class="intro-text">
        <h1>你好，我是{AUTHOR}</h1>
        <p>白天当牛马，晚上折腾些没用但有趣的东西。</p>
      </div>
      <div class="intro-links">
        <a href="https://github.com/Doyouhang"><Icon name="github" size={16} />GitHub</a>
      </div>
    </section>

    <div class="split">
      <div class="split-main">
        <div class="sec-hd">
          <h2>最近更新</h2>         
        </div>
        <RecentUpdates limit={7} />
      </div>

      <aside>
        <section class="side-box reveal">
          <h2>此刻</h2>
          {nowRows.map((item) => (
            <div class="side-row">
              <Icon name={item.icon} size={18} />
              <span>{item.text}</span>
            </div>
          ))}
          {nowAt && <p class="side-foot">跟着收藏和照片自动更新 · {cstISODate(new Date(nowAt))}</p>}
        </section>

        {movers.length > 0 && (
          <section class="side-box reveal">
            <h2>自选股 · 收盘</h2>
            {movers.map((r) => (
              <div class="side-row">
                <span>{r.name}</span>
                <span class={`side-val ${dirOf(r.percent!)}`}>{sign(r.percent!)}</span>
              </div>
            ))}
            <div class="spark" aria-hidden="true">
              {rows.map((r) => (
                <i
                  class={dirOf(r.percent!)}
                  style={`height:${Math.max(12, (Math.abs(r.percent!) / maxAbs) * 100)}%`}
                  title={`${r.name} ${sign(r.percent!)}`}
                ></i>
              ))}
            </div>
            <p class="side-foot">
              {rows.length} 只自选 · <a href={`${B}interests/stocks/`}>看全部 →</a>
            </p>
          </section>
        )}

        {heroPhoto && (
          <a class="side-shot" href={`${B}moments/`}>
            <Image src={heroPhoto.src} alt={heroPhoto.alt} width={620} />
            <span class="side-shot-cap">
              <Icon name="camera" size={14} />
              <span class="where">{heroMoment.data.place ?? '此间'}</span>
              <span class="go">→</span>
            </span>
          </a>
        )}
      </aside>
    </div>
  </div>

  <div class="band">
    <div class="container-wide band-inner">
      <div class="sec-hd">
        <h2>我的兴趣</h2>
        <span class="sec-note">攒下来的书、歌和琢磨过的东西</span>
      </div>
      <div class="int-row">
        {interests.map((i) => {
          const latest = latestOf(i.slug);
          return (
            <a class="int-cell reveal" href={`${B}interests/${i.slug}/`}>
              <span class="int-shelf">
                {latest?.data.cover ? (
                  <Image src={latest.data.cover} alt="" width={140} />
                ) : (
                  <span class="int-big" transition:name={`interest-${i.title}`}>
                    <Icon name={i.icon} size={26} />
                  </span>
                )}
              </span>
              <span class="int-name"><Icon name={i.icon} size={15} /><b>{i.title}</b></span>
              <span class="int-sub">
                {latest
                  ? (latest.data.kind === 'song' ? latest.data.title : `《${latest.data.title}》`)
                  : i.tags[0]}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 最近一张照片，放在右栏最底下。左栏六条比右边两个盒子高出一截，
     这张图正好把差补上；而且放在这儿它是「此间」的入口，
     比挤在名字旁边当装饰更有用 */
  /* 两栏齐平这件事交给这张图，别去猜「最近更新」该放几条 ——
     「此刻」的行数本来就随内容变（书读完了、出门拍了照就多一行），
     钉死一个数字迟早又对不上。.split 默认 align-items:start，
     这里改成 stretch 让右栏拉到和左栏一样高，剩余空间由照片吃掉。 */
  .split { align-items: stretch; }
  .split > aside { display: flex; flex-direction: column; }
  .side-shot {
    display: flex; flex-direction: column;
    flex: 1 1 auto; min-height: 168px; max-height: 340px;
    border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; background: var(--card); color: inherit;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .side-shot:hover { border-color: var(--accent); text-decoration: none; }
  .side-shot :global(img) {
    display: block; width: 100%; flex: 1 1 auto; min-height: 0; object-fit: cover;
  }
  .side-shot-cap {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; font-size: 13px; color: var(--muted);
    border-top: 1px solid var(--border);
  }
  .side-shot-cap .where { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .side-shot:hover .side-shot-cap { color: var(--accent); }

  /* 封面高矮胖瘦各不相同，装进一个等高的框里，六个格子才齐 */
  .int-shelf {
    width: 100%; height: 96px; border-radius: 8px; background: var(--bg-soft);
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .int-shelf :global(img) {
    max-height: 84px; max-width: 100%; width: auto; height: auto;
    border-radius: 4px; object-fit: contain;
  }
  .int-big { color: var(--accent); line-height: 0; }
  /* grid item 默认 min-width:auto。格子里那行书名是 nowrap 的，
     长一点就会把列撑宽、挤到别的格子 —— 这里让它老实收缩，交给省略号 */
  .int-cell { min-width: 0; }
  .int-name { display: flex; align-items: center; gap: 6px; color: var(--accent); line-height: 0; }
  .int-name b { font-size: 14px; font-weight: 600; color: var(--fg); line-height: 1.4; }
  .int-sub {
    font-size: 12px; color: var(--muted); text-align: center; max-width: 100%;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  @media (max-width: 760px) {
    /* 单栏之后没有"另一栏"可对齐，给个固定高度就行 */
    .split { align-items: start; }
    .side-shot { flex: 0 0 auto; max-height: none; }
    .side-shot :global(img) { flex: 0 0 auto; height: 140px; }
    .int-shelf { height: 76px; }
    .int-shelf :global(img) { max-height: 66px; }
  }
  /* 390px 上四列每格只剩八十来像素，封面和书名都挤成一条 */
  @media (max-width: 560px) {
    .int-row { grid-template-columns: repeat(3, 1fr); }
  }
</style>
