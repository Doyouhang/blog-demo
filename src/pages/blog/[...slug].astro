---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../utils/reading-time';
import { cstISODate } from '../../utils/cst';
import { AUTHOR } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('essays', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const B = import.meta.env.BASE_URL;
const minutes = readingMinutes(post.body ?? '');

// 目录：≥2 个 h2 才生成。id 对齐 Astro 给标题打的锚点（github-slugger 规则）
function slugify(text: string): string {
  return text
    .trim()
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^\p{L}\p{N}\-_~]/gu, '')
    .replace(/-{2,}/g, '-')
    .replace(/^-+|-+$/g, '');
}
const seen = new Map<string, number>();
const toc = (post.body ?? '')
  .split('\n')
  .filter((l) => l.startsWith('## ') && !l.startsWith('###'))
  .map((l) =>
    l.slice(3)
      .replace(/`([^`]*)`/g, '$1')
      .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/[*_]/g, '')
      .trim()
  )
  .map((text) => {
    let id = slugify(text);
    const n = seen.get(id) ?? 0;
    seen.set(id, n + 1);
    if (n > 0) id = `${id}-${n}`;
    return { text, id };
  });

// 结构化数据：让搜索引擎和分享卡片认出这是一篇博客文章
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: AUTHOR },
};

const posts = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedAt={post.data.pubDate}
>
  <div class="read-progress" aria-hidden="true"><span class="read-seal">阅</span></div>
  <article>
    <a class="eyebrow" href={`${B}blog/`}>← 返回博客</a>
    <h1 transition:name={`post-${post.id}`}>{post.data.title}</h1>
    <p class="date">
      {cstISODate(post.data.pubDate)}
      <span aria-hidden="true"> · </span>
      约 {minutes} 分钟读完
    </p>
    <div>
      {post.data.tags.map((t) => (
        <a class="tag" href={`${B}blog/tags/${encodeURIComponent(t)}/`}>{t}</a>
      ))}
    </div>
    {toc.length >= 2 && (
      <>
        {/* 宽屏：正文左外侧一列刻度，当前小节那道变长变朱红，悬停展开成面板 */}
        <nav class="toc-rail" aria-label="本文目录">
          {toc.map((t) => (
            <a href={`#${t.id}`} data-toc={t.id}>
              <i aria-hidden="true"></i><span>{t.text}</span>
            </a>
          ))}
        </nav>
        {/* 窄屏没有富余的横向空间，硬塞只会压正文，退回折叠块 */}
        <details class="toc-fold">
          <summary>目录</summary>
          <ol>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
          </ol>
        </details>
      </>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    import { onPageReady, markReady } from '../../scripts/init';

    // 读到底，进度条尾端落一枚「阅」印 —— 阅读=盖印的收尾
    function initReadSeal() {
      const bar = document.querySelector<HTMLElement>('.read-progress');
      if (!bar || !markReady(bar)) return;
      const atEnd = () =>
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const check = () => {
        if (!atEnd()) return;
        bar.classList.add('done');
        window.removeEventListener('scroll', check);
      };
      window.addEventListener('scroll', check, { passive: true });
      check();
    }
    onPageReady(initReadSeal);
  </script>
    <div class="prose preserve-breaks" style="margin-top:18px"><Content /></div>

    {(newer || older) && (
      <nav class="post-nav" aria-label="文章导航">
        <div>
          {newer && (
            <>
              <span class="post-nav-label">← 上一篇</span>
              <a href={`${B}blog/${newer.id}/`}>{newer.data.title}</a>
            </>
          )}
        </div>
        <div class="post-nav-next">
          {older && (
            <>
              <span class="post-nav-label">下一篇 →</span>
              <a href={`${B}blog/${older.id}/`}>{older.data.title}</a>
            </>
          )}
        </div>
      </nav>
    )}

  </article>
</BaseLayout>

<style>
  /* ——— 左侧刻度目录 ———
     只在放得下的宽度出现。正文 880px 居中之后两侧各只剩 260px，
     按「视口中线减半个正文宽」定位会直接压在正文上（第一版就是这么错的）。
     正确做法是让「刻度 + 正文」整体居中：正文让出左边一栏，刻度贴这一组的左缘。 */
  .toc-rail {
    position: fixed; left: calc(50% - 545px); top: 50%; transform: translateY(-50%);
    display: none; flex-direction: column; gap: 2px; z-index: 5; padding: 6px 0;
    /* 章节多的文章要能滚。刻度栏是垂直居中的固定定位，一旦比视口高，
       上半截会被顶到屏幕外、或者钻进吸顶页眉底下 —— 不是「看不全」，是点不到。
       《人类简史》18 章约 514px，1160px 宽的笔记本视口高度常常只有 700 上下。
       上限按「视口减固定留白」算而不是按比例：居中之后上下各剩 70px，
       比页眉高，跟视口多矮无关。用 vh 比例的话矮窗口下余量会跟着缩，白留隐患。 */
    max-height: calc(100vh - 140px); overflow-y: auto;
    overscroll-behavior: contain; scrollbar-width: thin;
  }
  .toc-rail a {
    display: flex; align-items: center; gap: 10px; height: 26px;
    color: var(--muted); text-decoration: none; font-size: 13px;
  }
  .toc-rail i {
    display: block; width: 18px; height: 2px; border-radius: 2px; flex: 0 0 auto;
    background: var(--border);
    transition: width var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .toc-rail span {
    max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0;
    /* 长标题要有省略号：切在半路会读成渲染坏了，不像是有意截断 */
    text-overflow: ellipsis;
    transition: max-width var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  /* 展开时浮成一块面板。间距只有几像素，不给底的话会读成「字压在正文上」 */
  .toc-rail:hover, .toc-rail:focus-within {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 14px; box-shadow: var(--shadow-card);
  }
  .toc-rail:hover span, .toc-rail:focus-within span { max-width: 200px; opacity: 1; }
  .toc-rail a[aria-current='true'] { color: var(--fg); }
  .toc-rail a[aria-current='true'] i { width: 30px; background: var(--seal); }
  .toc-rail a:hover i { background: var(--accent); }
  .toc-rail a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

  /* 窄屏的折叠块 */
  .toc-fold {
    border: 1px solid var(--border); border-radius: 8px; background: var(--card);
    padding: 10px 20px; margin: 20px 0 6px;
  }
  .toc-fold summary {
    cursor: pointer; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.14em; color: var(--muted); padding: 4px 0;
  }
  .toc-fold ol { margin: 8px 0 4px; padding-left: 20px; }
  .toc-fold li { margin: 0; font-size: 14px; }
  /* 净高 16px 不到 WCAG 2.2 的 24，padding 顶替 margin，总行高不变 */
  .toc-fold li a { display: inline-block; padding: 5px 0; }

  @media (min-width: 1160px) {
    .toc-rail { display: flex; }
    .toc-fold { display: none; }
    /* :has 不支持时正文保持居中、面板悬停时盖在正文上，仍然可用 */
    :global(main.container:has(.toc-rail)) { max-width: 1090px; padding-left: 234px; }
  }
  /* 标题跳转时别被吸顶的页眉盖住 */
  .prose :global(h2) { scroll-margin-top: 80px; }
</style>

<script>
  import { onPageReady, markReady } from '../../scripts/init';

  // 跟随高亮：当前小节 = 视口里最后一个越过 90px 线的标题。
  // 用 scroll 事件而不是 IntersectionObserver —— 小节高度差很大，
  // 交叉比例那套在长小节里会整段没有任何标题「在视口内」，高亮就断了。
  function initTocRail() {
    const rail = document.querySelector('.toc-rail') as HTMLElement | null;
    if (!markReady(rail)) return;
    const links = [...rail!.querySelectorAll('a[data-toc]')] as HTMLAnchorElement[];
    const heads = links
      .map((a) => document.getElementById(a.dataset.toc!))
      .filter((el): el is HTMLElement => !!el);
    if (!heads.length) return;
    const sync = () => {
      let cur = heads[0].id;
      for (const h of heads) if (h.getBoundingClientRect().top <= 90) cur = h.id;
      for (const a of links) {
        if (a.dataset.toc === cur) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', sync, { passive: true });
    sync();
  }
  onPageReady(initTocRail);
</script>
