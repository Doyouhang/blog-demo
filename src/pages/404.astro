---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
const B = import.meta.env.BASE_URL;
---
<BaseLayout title="页面不存在" description="你要找的页面不存在" fullWidth>
  <div class="container-wide">
    <PageHeader eyebrow="404" title="这个页面走丢了" lead="链接可能拼错了，或者内容已经挪走。">
      <div class="head-actions">
        <a class="btn-primary" href={`${B}`}>回到首页</a>
        <a class="btn-quiet" href={`${B}blog/`}>看看博客</a>
        <a class="btn-quiet" href={`${B}interests/`}>逛逛兴趣</a>
      </div>
    </PageHeader>
  </div>
</BaseLayout>
